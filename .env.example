# Local application runtime
APP_ENV=development
API_BASE_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:3000
SESSION_SECRET=replace-me-outside-local-development
DATABASE_URL=postgresql+asyncpg://cpfc:cpfc@localhost:5432/cpfc_trip
DATABASE_MIGRATION_URL=postgresql+psycopg://cpfc:cpfc@localhost:5432/cpfc_trip

# Temporal
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=cpfc-trip-planner
TEMPORAL_TLS=false
# TEMPORAL_API_KEY=
INACTIVITY_TIMEOUT_SECONDS=600

# Integrations. The checked-in local default uses deterministic demo data.
PLANNER_MODE=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=medium
EMAIL_MODE=preview
RESEND_API_KEY=
RESEND_FROM_EMAIL=Crystal Palace Away Days <awaydays@example.com>

# LOGFIRE_ENABLED=true
# LOGFIRE_TOKEN=
