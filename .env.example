APP_ENV=development
FRONTEND_ORIGIN=http://localhost:3000
ADDITIONAL_FRONTEND_ORIGINS=
PREVIEW_ACCESS_REQUIRED=true
PREVIEW_USERNAME=
PREVIEW_PASSWORD=
DATABASE_URL=postgresql+asyncpg://cpfc:cpfc@localhost:5432/cpfc
# Generated locally by scripts/configure-local.py; never commit real secrets.
CONTACT_ENCRYPTION_KEY=
SESSION_SECRET=
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=cpfc-trip-v3
TEMPORAL_TLS=false
TEMPORAL_API_KEY=
WORKER_BUILD_ID=
PLANNER_MODE=recorded
INACTIVITY_TIMEOUT_SECONDS=600
SEARCHAPI_API_KEY=
SEARCHAPI_ENABLED=true
# Production: ADC uses the Cloud Run service account. Local: explicitly select your work login.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=eu
GOOGLE_AUTH_MODE=adc
GEMINI_API_KEY=
GOOGLE_GCLOUD_CONFIGURATION=
GOOGLE_GCLOUD_ACCOUNT=
EMAIL_MODE=preview
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=
